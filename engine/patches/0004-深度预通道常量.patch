diff --git a/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered.glsl b/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered.glsl
index cc0b4ba..d31c083 100644
--- a/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered.glsl
+++ b/servers/rendering/renderer_rd/shaders/forward_clustered/scene_forward_clustered.glsl
@@ -12,6 +12,22 @@
 #define SHADER_IS_SRGB false
 #define SHADER_SPACE_FAR 0.0
 
+// IN_DEPTH_PREPASS: true while rendering the depth prepass of the main view (with or without normal/roughness),
+// false in shadow maps, the color pass, and the GI passes (SDFGI voxelization MODE_RENDER_SDF, GI baking
+// MODE_RENDER_MATERIAL), which need the full material. A compile-time false outside depth variants.
+// IN_NORMAL_PREPASS: the prepass also writes the normal/roughness buffer, which SSAO, SSIL, SSR, SDFGI/VoxelGI
+// and compositor effects read. A cheaper NORMAL there changes what those effects see.
+#if defined(MODE_RENDER_DEPTH) && !defined(MODE_RENDER_SDF) && !defined(MODE_RENDER_MATERIAL) && !defined(MODE_DUAL_PARABOLOID)
+#define IN_DEPTH_PREPASS (!bool(scene_data_block.data.flags & SCENE_DATA_FLAGS_IN_SHADOW_PASS))
+#else
+#define IN_DEPTH_PREPASS false
+#endif
+#if defined(MODE_RENDER_DEPTH) && defined(MODE_RENDER_NORMAL_ROUGHNESS)
+#define IN_NORMAL_PREPASS IN_DEPTH_PREPASS
+#else
+#define IN_NORMAL_PREPASS false
+#endif
+
 #ifdef USE_MULTIVIEW
 #define OUTPUT_IS_MULTIVIEW true
 #else
@@ -869,6 +885,22 @@ void main() {
 #define SHADER_IS_SRGB false
 #define SHADER_SPACE_FAR 0.0
 
+// IN_DEPTH_PREPASS: true while rendering the depth prepass of the main view (with or without normal/roughness),
+// false in shadow maps, the color pass, and the GI passes (SDFGI voxelization MODE_RENDER_SDF, GI baking
+// MODE_RENDER_MATERIAL), which need the full material. A compile-time false outside depth variants.
+// IN_NORMAL_PREPASS: the prepass also writes the normal/roughness buffer, which SSAO, SSIL, SSR, SDFGI/VoxelGI
+// and compositor effects read. A cheaper NORMAL there changes what those effects see.
+#if defined(MODE_RENDER_DEPTH) && !defined(MODE_RENDER_SDF) && !defined(MODE_RENDER_MATERIAL) && !defined(MODE_DUAL_PARABOLOID)
+#define IN_DEPTH_PREPASS (!bool(scene_data_block.data.flags & SCENE_DATA_FLAGS_IN_SHADOW_PASS))
+#else
+#define IN_DEPTH_PREPASS false
+#endif
+#if defined(MODE_RENDER_DEPTH) && defined(MODE_RENDER_NORMAL_ROUGHNESS)
+#define IN_NORMAL_PREPASS IN_DEPTH_PREPASS
+#else
+#define IN_NORMAL_PREPASS false
+#endif
+
 #ifdef USE_MULTIVIEW
 #define OUTPUT_IS_MULTIVIEW true
 #else
diff --git a/servers/rendering/shader_preprocessor.cpp b/servers/rendering/shader_preprocessor.cpp
index 2cdb144..54856ad 100644
--- a/servers/rendering/shader_preprocessor.cpp
+++ b/servers/rendering/shader_preprocessor.cpp
@@ -1363,6 +1363,10 @@ Error ShaderPreprocessor::preprocess(const String &p_code, const String &p_filen
 		insert_builtin_define("RENDERER_COMPATIBILITY", _MKSTR(0), pp_state);
 		insert_builtin_define("RENDERER_MOBILE", _MKSTR(1), pp_state);
 		insert_builtin_define("RENDERER_FORWARD_PLUS", _MKSTR(2), pp_state);
+
+		// This build has the IN_DEPTH_PREPASS / IN_NORMAL_PREPASS built-ins: wrap their use in
+		// #ifdef HAS_IN_DEPTH_PREPASS so the same shader still compiles on stock Godot.
+		insert_builtin_define("HAS_IN_DEPTH_PREPASS", _MKSTR(1), pp_state);
 	}
 
 	Error err = preprocess(&pp_state, p_code, r_result);
diff --git a/servers/rendering/shader_types.cpp b/servers/rendering/shader_types.cpp
index b733b6b..d6e3b1a 100644
--- a/servers/rendering/shader_types.cpp
+++ b/servers/rendering/shader_types.cpp
@@ -81,6 +81,8 @@ ShaderTypes::ShaderTypes() {
 	shader_modes[RSE::SHADER_SPATIAL].functions["global"].built_ins["TIME"] = constt(ShaderLanguage::TYPE_FLOAT);
 	shader_modes[RSE::SHADER_SPATIAL].functions["global"].built_ins["EXPOSURE"] = constt(ShaderLanguage::TYPE_FLOAT);
 	shader_modes[RSE::SHADER_SPATIAL].functions["global"].built_ins["IN_SHADOW_PASS"] = constt(ShaderLanguage::TYPE_BOOL);
+	shader_modes[RSE::SHADER_SPATIAL].functions["global"].built_ins["IN_DEPTH_PREPASS"] = constt(ShaderLanguage::TYPE_BOOL);
+	shader_modes[RSE::SHADER_SPATIAL].functions["global"].built_ins["IN_NORMAL_PREPASS"] = constt(ShaderLanguage::TYPE_BOOL);
 	shader_modes[RSE::SHADER_SPATIAL].functions["constants"].built_ins["PI"] = constvt(ShaderLanguage::TYPE_FLOAT, { pi_scalar });
 	shader_modes[RSE::SHADER_SPATIAL].functions["constants"].built_ins["TAU"] = constvt(ShaderLanguage::TYPE_FLOAT, { tau_scalar });
 	shader_modes[RSE::SHADER_SPATIAL].functions["constants"].built_ins["E"] = constvt(ShaderLanguage::TYPE_FLOAT, { e_scalar });
