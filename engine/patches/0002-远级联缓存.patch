+// Far cascade cache settings. Forward+ only: the other renderers clear the whole directional shadow atlas every frame.
+static int _far_cascade_update_interval() {
+	static const bool forward_plus = OS::get_singleton()->get_current_rendering_method() == "forward_plus";
+	if (!forward_plus) {
+		return 1;
+	}
+	return MAX(1, (int)GLOBAL_GET_CACHED(int, "rendering/lights_and_shadows/directional_shadow/far_cascade_update_interval"));
+}
