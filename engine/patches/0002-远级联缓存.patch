+void RendererSceneCull::_directional_shadow_cache_apply(RID p_viewport, bool p_reflection_probe, const Transform3D &p_cam_transform, uint32_t p_light_count) {
+	const int interval = _far_cascade_update_interval();
+	const uint64_t frame = RSG::rasterizer->get_frame_number();
+
+	// The atlas is shared: contents are only ours if the previous directional shadow render was for this viewport.
+	const bool usable = interval > 1 && !p_reflection_probe && p_viewport.is_valid() && p_viewport == directional_shadow_cache_viewport && p_light_count == directional_shadow_cache_light_count;
+	if (p_light_count > 0) {
+		directional_shadow_cache_viewport = p_reflection_probe ? RID() : p_viewport;
+		directional_shadow_cache_light_count = p_light_count;
+	}
+
+	cull.cache_cull_margin = interval > 1 && GLOBAL_GET_CACHED(bool, "rendering/lights_and_shadows/directional_shadow/far_cascade_cull_margin");
+
+	const uint64_t atlas_version = RSG::light_storage->directional_shadow_get_version();
+	for (uint32_t i = 0; i < cull.shadow_count; i++) {
+		Cull::Shadow &shadow = cull.shadows[i];
+		DirectionalShadowCache &cache = directional_shadow_cache[i];
+		const real_t texture_size = RSG::light_storage->get_directional_light_shadow_size(shadow.light_instance);
+
+		// Atlas recreated (size or 16-bit toggle), different light, different layout or changed bias/masks: drop everything.
+		const bool same_light = usable && cache.light_instance == shadow.light_instance && cache.texture_size == texture_size && cache.cascade_count == shadow.cascade_count && cache.atlas_version == atlas_version && cache.params_hash == shadow.cache_params_hash;
+		cache.light_instance = shadow.light_instance;
+		cache.texture_size = texture_size;
+		cache.cascade_count = shadow.cascade_count;
+		cache.atlas_version = atlas_version;
+		cache.params_hash = shadow.cache_params_hash;
+
+		for (uint32_t k = 0; k < shadow.cascade_count; k++) {
+			Cull::Shadow::Cascade &c = shadow.cascades[k];
+			DirectionalShadowCache::Entry &e = cache.entries[k];
+			if (!c.cacheable) {
+				e.valid = false;
+				continue;
+			}
+
+			// Compare the light direction with the one this entry was rendered with (not last frame's),
+			// so a slowly turning light can't drift unnoticed for a whole interval.
+			bool reuse = same_light && e.valid && e.cascade.transform.basis.is_equal_approx(c.transform.basis);
+			if (reuse) {
+				// Staggered: cascade k renders when frame % interval == k % interval, so far cascades take turns.
+				const bool due = frame - e.frame >= (uint64_t)interval || frame % (uint64_t)interval == (uint64_t)(k % (uint32_t)interval);
+				const real_t *have = e.cascade.have;
+				const bool covered = have[0] <= c.need[0] && c.need[1] <= have[1] && have[2] <= c.need[2] && c.need[3] <= have[3] && have[4] <= c.need[4] && c.need[5] <= have[5];
+				reuse = !due && covered;
+			}
+
+			if (reuse) {
+				const real_t split = c.split; // Split distances are relative to the camera: keep this frame's.
+				c = e.cascade;
+				c.split = split;
+				// Soft shadow radius in the scene shader is measured from range_begin along the light direction, relative to the camera.
+				const Transform3D &t = e.cascade.transform;
+				c.range_begin = t.basis.get_column(Vector3::AXIS_Z).normalized().dot(t.origin - p_cam_transform.origin);
+				c.skip_render = true;
+				directional_shadow_cache_stats[0]++;
+			} else {
+				directional_shadow_cache_stats[1]++;
+				e.valid = true;
+				e.frame = frame;
+				e.cascade = c;
+			}
+		}
+	}
+
+	if (interval > 1 && frame - directional_shadow_cache_stats_frame >= 600) {
+		print_verbose(vformat("far_cascade_cache: %d reused, %d rendered (cacheable cascades, last %d frames).", directional_shadow_cache_stats[0], directional_shadow_cache_stats[1], frame - directional_shadow_cache_stats_frame));
+		directional_shadow_cache_stats[0] = directional_shadow_cache_stats[1] = 0;
+		directional_shadow_cache_stats_frame = frame;
+	}
+}
