[configuration]

entry_symbol = "mars_sim_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://扩展/仿真核心/bin/libmars_sim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://扩展/仿真核心/bin/libmars_sim.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://扩展/仿真核心/bin/libmars_sim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://扩展/仿真核心/bin/libmars_sim.windows.template_release.x86_64.dll"
macos.debug.arm64 = "res://扩展/仿真核心/bin/libmars_sim.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://扩展/仿真核心/bin/libmars_sim.macos.template_release.arm64.dylib"
